"""Render EEG cross-device/session transfer."""
from pathlib import Path
import csv, textwrap
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams.update({{"font.family":"sans-serif", "font.sans-serif":{fonts!r}, "font.size":{fs}, "axes.spines.top":False, "axes.spines.right":False, "pdf.fonttype":42, "ps.fonttype":42, "svg.fonttype":"none"}})
ROOT=Path(__file__).resolve().parents[2]
with (ROOT/{data_path!r}).open("r", encoding="utf-8-sig", newline="") as h: rows=list(csv.DictReader(h))
def num(v):
    try: return float(v)
    except (TypeError, ValueError): return None
missing=[str(r.get("row_id") or i+1) for i,r in enumerate(rows) if num(r.get("value")) is None or num(r.get("ci_low")) is None or num(r.get("ci_high")) is None or not str(r.get("source_run_id") or "").strip()]
if not rows or missing: raise SystemExit("No figure rendered: incomplete EEG shift rows")
conds=list(dict.fromkeys(str(r.get("shift_condition") or "IID") for r in rows)); methods=list(dict.fromkeys(str(r.get("method") or "method") for r in rows))
fig,axes=plt.subplots(1,2,figsize=({width},3.2),sharey=True)
for panel,axis_name in zip(axes,("device_id","session_id")):
    panel.set_title(axis_name.replace("_"," ").title(),fontsize={panel_font_size})
    for mi,method in enumerate(methods):
        selected=[r for r in rows if str(r.get("method") or "")==method and str(r.get("shift_axis") or "")==axis_name]
        if not selected: selected=[r for r in rows if str(r.get("method") or "")==method]
        selected=sorted(selected,key=lambda r: conds.index(str(r.get("shift_condition") or "IID")))
        x=list(range(len(selected))); y=[num(r.get("value")) for r in selected]; lo=[num(r.get("ci_low")) for r in selected]; hi=[num(r.get("ci_high")) for r in selected]; c={colors!r}[mi%len({colors!r})]
        panel.plot(x,y,marker=("o","s","^","D","v")[mi%5],lw=1.3,ms=4,color=c,markerfacecolor="white",label=method); panel.fill_between(x,lo,hi,color=c,alpha=.12,linewidth=0)
    panel_conditions = list(dict.fromkeys(str(r.get("shift_condition") or "IID") for r in rows if str(r.get("shift_axis") or "") == axis_name)) or conds
    panel.set_xticks(range(len(panel_conditions)),["\\n".join(textwrap.wrap(c,13)) for c in panel_conditions],rotation=25,ha="right"); panel.set_xlabel("Shift condition"); panel.grid(axis="y",color="#D1D5DB",lw=.4,alpha=.6)
axes[0].set_ylabel({metric!r}); handles,labels=axes[0].get_legend_handles_labels()
if handles: fig.legend(handles,labels,frameon=False,ncol=min(3,len(labels)),loc="upper center",bbox_to_anchor=(.5,1.04))
fig.suptitle("Cross-device and cross-session transfer",y=1.08,fontsize={title_font_size}); fig.tight_layout(rect=(0,0,1,.92),pad=.7)
out=Path(__file__).with_name({stem!r})
for s in (".pdf",".svg"): fig.savefig(out.with_suffix(s),bbox_inches="tight")
fig.savefig(out.with_suffix(".png"),dpi={dpi},bbox_inches="tight"); plt.close(fig)
