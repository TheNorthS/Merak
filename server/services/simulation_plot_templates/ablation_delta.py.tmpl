"""Render component-removal losses relative to the full method."""
from pathlib import Path
import csv
import textwrap
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
from matplotlib.patches import Patch

plt.rcParams.update({{
    "font.family": "sans-serif", "font.sans-serif": {fonts!r},
    "font.size": {font_size}, "axes.labelsize": {font_size},
    "xtick.labelsize": {tick_font_size},
    "ytick.labelsize": {tick_font_size},
    "axes.linewidth": 0.8, "axes.spines.top": False,
    "axes.spines.right": False, "pdf.fonttype": 42,
    "ps.fonttype": 42, "svg.fonttype": "none",
}})
ROOT = Path(__file__).resolve().parents[2]
with (ROOT / {data_path!r}).open("r", encoding="utf-8-sig", newline="") as handle:
    rows = list(csv.DictReader(handle))

def number(raw):
    try: return float(str(raw).strip())
    except (TypeError, ValueError): return None

parsed = [(number(row.get("value")), number(row.get("ci_low")), number(row.get("ci_high"))) for row in rows]
missing = [str(row.get("row_id") or i + 1) for i, (row, values) in enumerate(zip(rows, parsed))
           if any(value is None for value in values) or not str(row.get("source_run_id") or "").strip()]
if not rows or missing:
    raise SystemExit("No figure rendered: incomplete ablation rows: " + (", ".join(missing) if missing else "all rows"))
baseline_index = next((i for i, row in enumerate(rows) if str(row.get({label_field!r}) or "") == {baseline_label!r}), 0)
baseline_value, baseline_low, baseline_high = parsed[baseline_index]
maximize = {metric_direction!r} == "maximize"
losses, loss_low, loss_high = [], [], []
for value, low, high in parsed:
    if maximize:
        loss, lo, hi = baseline_value - value, baseline_low - high, baseline_high - low
    else:
        loss, lo, hi = value - baseline_value, low - baseline_high, high - baseline_low
    losses.append(loss); loss_low.append(lo); loss_high.append(hi)
group_order = {{"objective": 0, "architecture": 1, "protocol": 2}}
order = [baseline_index] + sorted(
    [i for i in range(len(rows)) if i != baseline_index],
    key=lambda i: (
        group_order.get(str(rows[i].get("ablation_group") or "architecture"), 1),
        -losses[i],
    ),
)
labels = [textwrap.fill(str(rows[i].get({label_field!r}) or "Component"), 28) for i in order]
y = list(range(len(order)))
fig, ax = plt.subplots(figsize=({width}, max(2.55, 0.55 * len(order) + 1.2)))
ax.axvline(0.0, color={dark!r}, linewidth=0.9, zorder=1)
for rank, index in enumerate(order):
    loss = losses[index]
    group = str(rows[index].get("ablation_group") or "architecture")
    group_colors = {{"objective": {objective!r}, "architecture": {architecture!r}, "protocol": {protocol!r}}}
    color = {baseline!r} if index == baseline_index else group_colors.get(group, {accent!r})
    if loss < 0 and index != baseline_index: color = {neutral!r}
    if index == baseline_index:
        ax.scatter(0.0, rank, marker="D", s=28, color=color, edgecolor="white", linewidth=0.6, zorder=3)
    else:
        ax.barh(rank, loss, height=0.58, color=color, alpha=0.88, zorder=2)
        ax.errorbar(loss, rank, xerr=[[max(0.0, loss - loss_low[index])], [max(0.0, loss_high[index] - loss)]],
                    fmt="none", ecolor={dark!r}, elinewidth=1.0, capsize=2.2, zorder=3)
    ax.annotate("baseline" if index == baseline_index else f"{{loss:+.3g}}",
                (loss, rank), xytext=(5 if loss >= 0 else -5, 0), textcoords="offset points",
                ha="left" if loss >= 0 else "right", va="center", fontsize={annotation_font_size})
ax.set_yticks(y, labels); ax.invert_yaxis()
previous_group = "full"
for rank, index in enumerate(order):
    group = str(rows[index].get("ablation_group") or "architecture")
    if rank > 1 and group != previous_group:
        ax.axhline(rank - 0.5, color="#D1D5DB", linewidth=0.7, zorder=0)
    previous_group = group
observed_groups = [
    group for group in ("objective", "architecture", "protocol")
    if any(str(row.get("ablation_group") or "architecture") == group for row in rows)
]
legend_handles = [Patch(facecolor={baseline!r}, label="Full model")] + [
    Patch(facecolor=group_colors[group], label=group.title()) for group in observed_groups
]
ax.legend(handles=legend_handles, frameon=False, ncol=min(4, len(legend_handles)), loc="lower right")
ax.set_xlabel("Performance degradation relative to full model (Δ " + {metric!r}.replace("_", " ").title() + ")")
ax.margins(x=0.16, y=0.14); fig.tight_layout(pad=0.75)
output = Path(__file__).with_name({stem!r})
for suffix in (".pdf", ".svg"): fig.savefig(output.with_suffix(suffix), bbox_inches="tight")
fig.savefig(output.with_suffix(".png"), dpi={dpi}, bbox_inches="tight")
plt.close(fig)
