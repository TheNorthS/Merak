"""Render downstream EEG error rates as a labeled heatmap."""
from pathlib import Path
import csv
import textwrap
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
plt.rcParams.update({{"font.family":"sans-serif", "font.sans-serif":{fonts!r}, "font.size":{font_size}, "axes.labelsize":{font_size}, "pdf.fonttype":42, "ps.fonttype":42, "svg.fonttype":"none"}})
ROOT = Path(__file__).resolve().parents[2]
with (ROOT / {data_path!r}).open("r", encoding="utf-8-sig", newline="") as handle: rows = list(csv.DictReader(handle))
def number(raw):
    try: return float(str(raw).strip())
    except (TypeError, ValueError): return None
missing = [str(r.get("row_id") or i+1) for i,r in enumerate(rows) if number(r.get("value")) is None or number(r.get("ci_low")) is None or number(r.get("ci_high")) is None or not str(r.get("source_run_id") or "").strip()]
if not rows or missing: raise SystemExit("No figure rendered: incomplete error-map rows: " + (", ".join(missing) if missing else "all rows"))
labels = [str(r.get({label_field!r}) or "dataset") for r in rows]
values = [number(r.get("value")) for r in rows]
lo = [number(r.get("ci_low")) for r in rows]; hi = [number(r.get("ci_high")) for r in rows]
fig, ax = plt.subplots(figsize=({width}, max(2.7, 0.34 * len(rows) + 1.3)))
heat = ax.imshow([values], cmap="YlOrRd", aspect="auto", vmin=min(values)-0.01, vmax=max(values)+0.01)
ax.set_yticks([0], ["Full method"]); ax.set_xticks(range(len(labels)), ["\\n".join(textwrap.wrap(label, 15)) for label in labels], rotation=35, ha="right")
for idx, (value, lower, upper) in enumerate(zip(values, lo, hi)):
    ax.text(idx, 0, f"{{value:.3f}}\\n[{{lower:.3f}}, {{upper:.3f}}]", ha="center", va="center", fontsize={tick_font_size}, color="black")
ax.set_xlabel("Downstream dataset / task"); ax.set_title({metric!r} + " by dataset", fontsize={panel_font_size})
fig.colorbar(heat, ax=ax, fraction=0.035, pad=0.03, label={metric!r})
fig.tight_layout(pad=0.75)
output = Path(__file__).with_name({stem!r})
for suffix in (".pdf", ".svg"): fig.savefig(output.with_suffix(suffix), bbox_inches="tight")
fig.savefig(output.with_suffix(".png"), dpi={dpi}, bbox_inches="tight")
plt.close(fig)
