"""Fill every value cell in {data_path}, then rerun this script."""
from pathlib import Path
import csv
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

plt.rcParams.update({{
    "font.family": "sans-serif",
    "font.sans-serif": {fonts!r},
    "font.size": {font_size},
    "axes.labelsize": {font_size},
    "xtick.labelsize": {tick_font_size},
    "ytick.labelsize": {tick_font_size},
    "legend.fontsize": {tick_font_size},
    "axes.linewidth": 0.8,
    "xtick.major.width": 0.8,
    "ytick.major.width": 0.8,
    "xtick.direction": "out",
    "ytick.direction": "out",
    "axes.spines.top": False,
    "axes.spines.right": False,
    "pdf.fonttype": 42,
    "ps.fonttype": 42,
    "svg.fonttype": "none",
}})

ROOT = Path(__file__).resolve().parents[2]
with (ROOT / {data_path!r}).open("r", encoding="utf-8-sig", newline="") as handle:
    rows = list(csv.DictReader(handle))

def number(raw):
    try:
        return float(str(raw).strip())
    except (TypeError, ValueError):
        return None

values = [number(row.get("value")) for row in rows]
ci_low = [number(row.get("ci_low")) for row in rows]
ci_high = [number(row.get("ci_high")) for row in rows]
missing = [
    str(row.get("row_id") or index + 1)
    for index, (row, value, low, high) in enumerate(zip(rows, values, ci_low, ci_high))
    if (
        value is None or low is None or high is None
        or not str(row.get("source_run_id") or "").strip()
    )
]
if not rows or missing:
    detail = ", ".join(missing) if missing else "all rows"
    raise SystemExit(
        "No figure rendered: fill provenance-backed value, ci_low, ci_high, and source_run_id "
        f"for these rows first: {{detail}}"
    )
if any(low > value or high < value for value, low, high in zip(values, ci_low, ci_high)):
    raise SystemExit("No figure rendered: each CI must contain its estimate.")
fig, ax = plt.subplots(figsize=({width}, 3.55))
methods = list(dict.fromkeys(row["method"] for row in rows))
markers = ["o", "s", "^", "D", "v"]
line_styles = ["--", "-", "-.", ":", "-"]
for index, method in enumerate(methods):
    selected = sorted(
        [row for row in rows if row["method"] == method],
        key=lambda row: float(row[{axis!r}]),
    )
    x = [float(row[{axis!r}]) for row in selected]
    y = [number(row.get("value")) for row in selected]
    low = [number(row.get("ci_low")) for row in selected]
    high = [number(row.get("ci_high")) for row in selected]
    color = {colors!r}[index % len({colors!r})]
    ax.plot(
        x, y, marker=markers[index % len(markers)], markersize=4.2,
        linewidth=1.5, linestyle=line_styles[index % len(line_styles)],
        color=color, markerfacecolor="white", markeredgewidth=0.9, label=method,
    )
    ax.fill_between(x, low, high, color=color, alpha=0.12, linewidth=0)
ax.set_xlabel({axis!r}.replace("_", " ").title())
ax.set_ylabel({metric!r}.replace("_", " ").title())
all_x = sorted({{float(row[{axis!r}]) for row in rows}})
if all_x and min(all_x) > 0 and max(all_x) / min(all_x) >= 100:
    ax.set_xscale("log")
elif all(value.is_integer() for value in all_x):
    ax.set_xticks(all_x)
ax.legend(frameon=False, ncol=min(3, max(1, len(methods))), loc="best", handlelength=2.6)
ax.margins(x=0.03, y=0.12)
fig.tight_layout(pad=0.7)
output = Path(__file__).with_name({output_stem!r})
fig.savefig(output.with_suffix(".pdf"), bbox_inches="tight")
fig.savefig(output.with_suffix(".svg"), bbox_inches="tight")
fig.savefig(output.with_suffix(".png"), dpi={dpi}, bbox_inches="tight")
plt.close(fig)
