# Merak 本地后端配置模板
# 首次源码运行时复制为 .env；已有 .env 时保留原文件并按需修改。
# .env 只保存在本机；此模板可以提交到 GitHub。
# 修改后重启后端生效。相同配置项的进程环境变量优先于 .env。
#
# 模型 API Key、接口地址、模型名称，以及画图、Exa、Zotero、Obsidian、
# Vast.ai、Modal 等服务，请在软件的“设置”面板填写并测试连接。
# 面板配置保存到 merak_ide.db 和 user_settings.json；保存操作不改写 .env。
# 正常启动的模型路由使用面板配置，不会从此文件自动导入模型密钥。

# ===== 本地运行 =====
# 桌面及 npm run server 启动器使用 127.0.0.1:8011。
# 自部署的监听地址和端口由 Uvicorn 启动参数指定。
# 本地开发可开启 debug；对外部署时关闭。
MERAK_IDE_DEBUG=true

# ===== 数据与项目目录 =====
# 默认使用当前工作目录；安装版的工作目录是应用用户数据目录。
# DATA_DIR 存放设置数据库与 JSON；DATABASE_URL 指定业务数据库。
# 使用同一 SQLite 数据库时，两项应对应同一目录下的 merak_ide.db。
MERAK_IDE_DATA_DIR=.
MERAK_IDE_DATABASE_URL=sqlite+aiosqlite:///./merak_ide.db
MERAK_IDE_WORKSPACE_ROOT=./data/projects

# ===== 内置技能 =====
# 源码运行使用此相对路径；安装版启动器自动提供随包技能的绝对路径。
MERAK_IDE_MERAK_SKILLS_PATH=./merak-skills

# ===== 认证与集成凭据 =====
MERAK_IDE_ALLOW_REGISTRATION=false
# Web 部署使用至少 32 字符的私有 JWT 密钥；省略时每次后端启动随机生成。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# MERAK_IDE_JWT_SECRET_KEY=
# 可选固定凭据加密密钥，供 Overleaf 保存同步凭据使用。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# MERAK_IDE_SSH_ENCRYPTION_KEY=

# ===== Web 部署（可选） =====
# 允许访问后端的前端来源，使用 JSON 数组；本地默认值已包含桌面与 Vite。
# MERAK_IDE_CORS_ORIGINS='["https://research.example.com"]'

# ===== 设置面板尚未提供的文献服务选项（可选） =====
# Semantic Scholar 请求密钥。
# S2_API_KEY=
# OpenAlex 请求密钥与联系邮箱。
# OPENALEX_API_KEY=
# OPENALEX_EMAIL=
# PubMed / NCBI 请求密钥。
# NCBI_API_KEY=
